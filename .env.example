NEXT_PUBLIC_WIX_CLIENT_ID=
# Optional/reference only. The current Wix OAuth client uses NEXT_PUBLIC_WIX_CLIENT_ID.
WIX_ACCOUNT_ID=
WIX_SITE_ID=
WIX_ARTICLES_COLLECTION_ID=articles
WIX_BLOGS_COLLECTION_ID=blogPosts
WIX_EBOOKS_COLLECTION_ID=Import5
WIX_DOWNLOADS_COLLECTION_ID=downloadableResources
WIX_WORKSHOP_ALBUMS_COLLECTION_ID=workshopAlbums
WIX_GALLERY_ALBUMS_COLLECTION_ID=galleryAlbums
WIX_TEAM_MEMBERS_COLLECTION_ID=teamMembers
WIX_PARTNERS_SPONSORS_COLLECTION_ID=partnersSponsors
WIX_TESTIMONIALS_COLLECTION_ID=testimonials

# PayFast checkout.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
# Optional. Set only if the same passphrase is configured in the PayFast dashboard.
PAYFAST_PASSPHRASE=
# Use sandbox for testing, production for live payments.
PAYFAST_MODE=sandbox
# Alternative to PAYFAST_MODE. Set true to force sandbox mode.
PAYFAST_SANDBOX=true
# Optional override for PayFast ITN server validation.
PAYFAST_VALIDATE_URL=

# Public site origin used for PayFast return, cancel and notify URLs.
SITE_URL=https://edureach.network
NEXT_PUBLIC_SITE_URL=https://edureach.network
EDUREACH_SITE_URL=https://edureach.network

# Paid-order email delivery through Resend.
RESEND_API_KEY=
# The sender domain must be verified in Resend before live customer emails are sent.
EDUREACH_EMAIL_FROM=EduReach <downloads@edureach.network>
EDUREACH_EMAIL_REPLY_TO=
# Use a long random secret. It signs email-only download links and must not be committed.
EDUREACH_DOWNLOAD_LINK_SECRET=
# Default: seven days.
EDUREACH_EMAIL_DOWNLOAD_TTL_SECONDS=604800

# API request protection.
# Use a long random secret in Vercel. Do not commit the real value.
EDUREACH_RATE_LIMIT_SECRET=
EDUREACH_RATE_LIMIT_CONTACT_MAX=10
EDUREACH_RATE_LIMIT_CONTACT_WINDOW_SECONDS=60
EDUREACH_RATE_LIMIT_CHECKOUT_MAX=20
EDUREACH_RATE_LIMIT_CHECKOUT_WINDOW_SECONDS=60
EDUREACH_RATE_LIMIT_ORDERS_MAX=60
EDUREACH_RATE_LIMIT_ORDERS_WINDOW_SECONDS=60
EDUREACH_RATE_LIMIT_DOWNLOADS_MAX=60
EDUREACH_RATE_LIMIT_DOWNLOADS_WINDOW_SECONDS=60

# Optional production-only CMS debug access.
# Supply this as the x-edureach-admin-secret request header when debug data is needed.
EDUREACH_ADMIN_DEBUG_SECRET=

# EduReach admin workspace.
# Configure the administrator identity and password hash in Vercel. Do not commit real values.
# Generate a scrypt hash in the format scrypt$16384$8$1$<salt>$<hash>.
EDUREACH_ADMIN_EMAIL=
EDUREACH_ADMIN_PASSWORD_HASH=
EDUREACH_ADMIN_SESSION_HOURS=8
EDUREACH_RATE_LIMIT_ADMIN_LOGIN_MAX=5
EDUREACH_RATE_LIMIT_ADMIN_LOGIN_WINDOW_SECONDS=600
