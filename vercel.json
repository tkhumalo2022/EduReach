    },
    {
      "source": "/resources/gallery/:slug",
      "destination": "/resources/gallery/detail.html"
    },
    {
      "source": "/blog/:slug",
      "destination": "/blog/detail.html"
    },
    {
      "source": "/team/:slug",
      "destination": "/team/detail.html"
    },
    {
      "source": "/partners/:slug",
